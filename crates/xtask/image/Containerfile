# The image a flyco session runs in (issue #235): what `flycod.sh` puts on a
# session VM, minus systemd, on Ubuntu 24.04. Built and pushed by
# `cargo xtask publish-flycod` with the daemon it carries, so the image, the
# installer and the binaries in the release bucket are one commit's worth.
#
# The base runtime layer depends only on `flycod.sh`, so BuildKit's registry
# cache reuses the entire apt + Bun + harness-CLI layer whenever only `flycod`
# Rust code changes. The target-architecture `flycod` binary is copied into a
# separate layer afterwards and verified natively with `flycod --version`.
FROM ubuntu:24.04
LABEL org.opencontainers.image.source="https://github.com/May-Agent/flyco"
RUN --mount=type=bind,source=flycod.sh,target=/tmp/flycod.sh \
    sh /tmp/flycod.sh image-runtime
ARG TARGETARCH
COPY --chmod=0755 image-bin/${TARGETARCH}/flycod /usr/local/bin/flycod
RUN /usr/local/bin/flycod --version
COPY --chmod=0755 flyco-session /usr/local/bin/flyco-session
# Run the daemon entrypoint as root so it exclusively owns `0600`
# `/etc/flycod/config.toml` and non-agent-writable managed policy directories,
# while `flycod run` drops privileges to the unprivileged `flyco` user for
# every harness, `!` shell, PTY, and virtual desktop process.
USER root
WORKDIR /srv/flyco/work
ENV HOME=/var/lib/flyco/daemon-home
ENV PATH=/home/flyco/.bun/bin:/usr/local/bin:/usr/bin:/bin
# Default command runs `flyco-session` for container platforms (ECS, ACI,
# Cloud Run, Podman hosts) while allowing devcontainer runtimes such as GitHub
# Codespaces to override `CMD` cleanly via `overrideCommand`.
CMD ["/usr/local/bin/flyco-session"]
